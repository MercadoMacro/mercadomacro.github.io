// Jade no WhatsApp (worker "mercadomacro-whatsapp"). Publicado pelo .github/workflows/publicar-whatsapp.yml.
// Endereço do webhook na Meta: https://mercadomacro-whatsapp.danilo-nillo.workers.dev/webhook
// Os segredos (META_APP_SECRET, WEBHOOK_VERIFY_TOKEN, WHATSAPP_PRODUCTION_ACCESS_TOKEN, WHATSAPP_ACCESS_TOKEN)
// ficam só no painel da Cloudflare; a publicação não mexe neles.
{
  "name": "mercadomacro-whatsapp",
  "main": "worker.js",
  "compatibility_date": "2026-11-14",
  "workers_dev": true,
  // sem endereços de prévia por versão (como estava antes de o código vir para o GitHub)
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "d1_databases": [
    { "binding": "HANDOFF_DB", "database_name": "mercadomacro-atendimento", "database_id": "c1cde2a2-b328-4a1a-a7a0-a13578eddcab" }
  ],
  // consulta da watchlist, preços e aviso à equipe pelo site (src/jade-whatsapp.js, classe JadeWatchlist)
  "services": [{ "binding": "JADE", "service": "station", "entrypoint": "JadeWatchlist" }]
}
