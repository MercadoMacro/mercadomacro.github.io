// Worker das cotações e fontes do site (shrill-meadow-89c1).
// Publicado pelo .github/workflows/publicar-worker.yml a cada mudança nesta pasta.
// As chaves (FINNHUB_API_KEY, FMP_API_KEY, FRED_API_KEY) são segredos guardados na Cloudflare:
// a publicação não mexe nelas, e keep_vars mantém as variáveis criadas pelo painel.
{
  "name": "shrill-meadow-89c1",
  "main": "shrill-meadow-89c1.js",
  "compatibility_date": "2025-06-01",
  "keep_vars": true,
  // registros guardados por 7 dias no painel da Cloudflare (Observability). Plano grátis: até 0,5 GB/dia;
  // se passar, a Cloudflare para de guardar até 00h UTC. Para guardar menos, baixe head_sampling_rate (0 a 1).
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // Valores iniciais generosos para redes compartilhadas. Cada contador é por IP/região.
  // registro de quem chega sem o passe do site (tabela passe_registro): mesmo banco do site
  "d1_databases": [
    { "binding": "LOG", "database_name": "mercadomacro-usuarios", "database_id": "5e07a14a-0498-4338-a785-785648d4d879" }
  ],
  // "registrar": só anota quem chega sem passe; "bloquear": recusa (ver conferePasse)
  "vars": { "PASSE_MODO": "registrar" },
  "ratelimits": [
    { "name": "API_RATE_GENERAL", "namespace_id": "2026101801", "simple": { "limit": 600, "period": 60 } },
    { "name": "API_RATE_HISTORY", "namespace_id": "2026101802", "simple": { "limit": 180, "period": 60 } },
    { "name": "API_RATE_PREMIUM", "namespace_id": "2026101803", "simple": { "limit": 60, "period": 60 } }
  ]
}
