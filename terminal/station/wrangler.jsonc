// Site Mercado Macro (worker "station").
// Publicado pelo .github/workflows/publicar-site.yml a cada mudança em station/.
// src/index.js é o porteiro: só quem tem cadastro liberado vê o site (usuários no D1 "mercadomacro-usuarios").
{
  "name": "station",
  "main": "src/index.js",
  "compatibility_date": "2025-06-01",
  // nodejs_compat: exigido pelo @cloudflare/puppeteer (navegador na nuvem, src/foto-fechamento.js)
  "compatibility_flags": ["nodejs_compat"],
  // navegador na nuvem (Browser Rendering): foto do cartão do fechamento sem o GitHub. Plano pago: 10 h/mês incluídas
  "browser": { "binding": "BROWSER" },
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "workers_dev": true,
  // registros guardados por 7 dias no painel da Cloudflare (Observability). Plano pago (desde 11/11/2026):
  // 20 milhões de registros por mês incluídos. Para guardar menos, baixe head_sampling_rate (0 a 1).
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "routes": [
    { "pattern": "mercadomacro.com.br", "custom_domain": true },
    { "pattern": "www.mercadomacro.com.br", "custom_domain": true }
  ],
  // resumo semanal no Telegram: segunda 11:00 UTC (8h em Brasília); assinaturas: todo dia 12:00 UTC (avisos e vencimentos)
  // fechamento: dias úteis 21:00 UTC (18h em Brasília) dispara o robô resumo.yml e guarda a página pública
  // a cada minuto: alarmes de preço da Jade (src/alarmes.js)
  "triggers": { "crons": ["0 11 * * 1", "*/15 * * * *", "0 21 * * 1-5", "0 23 * * 1-5", "* * * * *"] },
  // cotações para o fechamento enviado pelo botão de /admin (worker da API, sem passar pela internet)
  "services": [{ "binding": "API", "service": "shrill-meadow-89c1" }],
  // repasse ao vivo da Capital.com (src/capital.js): um objeto só, uma conexão com a Capital
  "durable_objects": { "bindings": [{ "name": "CAPITAL", "class_name": "CapitalRelay" }, { "name": "NEWS", "class_name": "NewsRelay" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CapitalRelay"] }, { "tag": "v2-news", "new_sqlite_classes": ["NewsRelay"] }],
  "d1_databases": [
    { "binding": "DB", "database_name": "mercadomacro-usuarios", "database_id": "5e07a14a-0498-4338-a785-785648d4d879" }
  ]
}
