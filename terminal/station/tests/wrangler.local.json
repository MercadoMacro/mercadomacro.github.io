{
  "name": "mercadomacro-revisao-local",
  "main": "../src/index.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mm-revisao-local",
      "database_id": "00000000-0000-4000-8000-000000000019",
      "remote": false
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEWS",
        "class_name": "NewsRelay"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-news",
      "new_sqlite_classes": [
        "NewsRelay"
      ]
    }
  ]
}
